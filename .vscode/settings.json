{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  "files.exclude": {
    "**/.terraform": true,
    "**/.venv": true,
    "**/.cache": true
  },
  "search.exclude": {
    "**/node_modules": true
  },
  "tfxhub.naming.enforceLegacyTokens": true,
  "tfxhub.naming.legacyTokens": [
    "Contractor",
    "Association"
  ],
  "tfxhub.naming.canonicalMap": {
    "Contractor": "CCMS",
    "Association": "AMMS"
  },
  "python.pythonPath": "venv/bin/python",
  "python.formatting.provider": "black",
  "python.linting.enabled": true,
  "python.linting.ruffEnabled": true,
  "python.linting.pylintEnabled": false,
  "python.sortImports.args": [
    "-rc"
  ],
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "typescriptreact",
    "json"
  ],
  "eslint.options": {
    "rules": {
      "no-restricted-syntax": [
        "error",
        {
          "selector": "Literal[value='Contractor']",
          "message": "Use 'CCMS' instead of 'Contractor' (per naming convention)"
        },
        {
          "selector": "Literal[value='Association']",
          "message": "Use 'AMMS' instead of 'Association' (per naming convention)"
        }
      ]
    }
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.strict": true,
  "typescript.preferences.includeCompletionsForModuleExports": true,
  "typescript.preferences.includeCompletionsWithInsertText": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "typescript.preferences.quoteStyle": "single",
  "typescript.preferences.useAliasesForRenames": true,
  "typescript.preferences.allowRenameOfImportPath": true,
  "typescript.preferences.allowTextChangesInNewFiles": true,
  "typescript.preferences.strictNullChecks": true,
  "typescript.preferences.strictFunctionTypes": true,
  "typescript.preferences.strictBindCallApply": true,
  "typescript.preferences.strictPropertyInitialization": true,
  "typescript.preferences.noImplicitAny": true,
  "typescript.preferences.noImplicitThis": true,
  "typescript.preferences.alwaysStrict": true,
  "typescript.preferences.forceConsistentCasingInFileNames": true,
  "typescript.preferences.noFallthroughCasesInSwitch": true,
  "typescript.preferences.noUnusedLocals": true,
  "typescript.preferences.noUnusedParameters": true,
  "typescript.preferences.noImplicitReturns": true,
  "typescript.preferences.noImplicitOverride": true,
  "typescript.preferences.noPropertyAccessFromIndexSignature": true,
  "typescript.preferences.noUncheckedIndexedAccess": true,
  "typescript.preferences.exactOptionalPropertyTypes": true,
  "typescript.preferences.useUnknownInCatchVariables": true,
  "typescript.preferences.allowUnreachableCode": false,
  "typescript.preferences.allowUnusedLabels": false,
  "typescript.preferences.allowJs": false,
  "typescript.preferences.checkJs": false,
  "typescript.preferences.maxNodeModuleJsDepth": 2,
  "typescript.preferences.jsx": "react-jsx",
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": ".*\\.py$",
        "cmd": "python /scripts/policy_check.py"
      },
      {
        "match": ".*\\.py$",
        "cmd": "python -m ruff check  || true"
      },
      {
        "match": ".*\\.py$",
        "cmd": "python -m black --fast  || true"
      }
    ]
  },
  "security.workspace.trust.untrustedFiles": "open",
  "extensions.autoUpdate": true,
  "extensions.ignoreRecommendations": false,
  "makefile.configureOnOpen": false,
  "editor.tabSize": 2,
  "terminal.integrated.profiles.linux": {
    "bash-custom": {
      "path": "/bin/bash",
      "args": [
        "-l"
      ]
    }
  }
}
