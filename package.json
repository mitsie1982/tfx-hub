{
  "type": "module",
  "name": "tfx-hub",
  "version": "1.0.0",
  "description": "TFX Hub workspace with shared mobile and client logic",
  "main": "index.js",
  "scripts": {
    "fix:elifecycle": "bash scripts/fix-elifecycle.sh --npm",
    "fix:elifecycle:yarn": "bash scripts/fix-elifecycle.sh --yarn",
    "fix:elifecycle:auto": "[ -f yarn.lock ] && bash scripts/fix-elifecycle.sh --yarn || bash scripts/fix-elifecycle.sh --npm",
    "build": "tsc",
    "test:demo": "jest --config jest.demo.config.js",
    "semantic-release": "semantic-release",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "stack:local:windows:autostart:install": "powershell -ExecutionPolicy Bypass -File ./scripts/install_local_live_stack_autostart_windows.ps1",
    "stack:local:windows:autostart:status": "powershell -ExecutionPolicy Bypass -File ./scripts/status_local_live_stack_autostart_windows.ps1",
    "stack:local:windows:autostart:remove": "powershell -ExecutionPolicy Bypass -File ./scripts/remove_local_live_stack_autostart_windows.ps1",
    "pg:local:windows:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start_repo_local_postgres_windows.ps1",
    "pg:local:windows:status": "powershell -ExecutionPolicy Bypass -File ./scripts/status_repo_local_postgres_windows.ps1",
    "pg:local:windows:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop_repo_local_postgres_windows.ps1",
    "stack:local:windows:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start_local_live_stack_windows.ps1",
    "stack:local:windows:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop_local_live_stack_windows.ps1",
    "stack:local:windows:status": "powershell -ExecutionPolicy Bypass -File ./scripts/status_local_live_stack_windows.ps1",
    "stack:local:windows:smoke": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke_local_live_stack_windows.ps1",
    "start:api": "pnpm --filter @tfx/api-server start",
    "migrate:api:postgres": "node scripts/apply_api_schema_postgres.cjs",
    "docs:contractor:generate": "node scripts/generate_contractor_docs.cjs",
    "docs:contractor:check": "node scripts/check_contractor_docs_sync.cjs",
    "smoke:api:postgres": "node scripts/smoke_api_server_postgres.cjs",
    "smoke:api:admin:local": "node scripts/smoke_admin_runtime_local.cjs",
    "smoke:api:smtp:local": "node scripts/smoke_password_reset_smtp.cjs",
    "smoke:api:smtp:local:auto": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke_password_reset_smtp_local.ps1",
    "smoke:api:meta:local": "node scripts/smoke_meta_whatsapp_local.cjs",
    "smoke:api:meta:recipient:option1:preflight": "node scripts/meta_whatsapp_option1_preflight.cjs",
    "smoke:api:meta:whatsapp": "node scripts/smoke_meta_whatsapp_webhook.cjs",
    "smoke:api:meta:recipient:option1": "powershell -ExecutionPolicy Bypass -File ./scripts/run_meta_recipient_option1.ps1",
    "test": "node scripts/check_contractor_docs_sync.cjs && pnpm --filter @tfx/shared-logic test && pnpm --filter @tfx/api-server test && pnpm --filter @tfx/contractor-app test && pnpm --filter @tfx/customer-app test && pnpm --filter @tfx/ams-app test && pnpm --filter @tfx/members-app test && pnpm --filter @tfx/contractor-mobile-app test && pnpm --dir apps/customer-app test && pnpm --dir apps/ams-app test && pnpm --dir apps/members-app test && node tests/browser-hosts/unit/run_unit_tests.cjs",
    "test:api-server": "pnpm --filter @tfx/api-server test",
    "test:shared-logic": "pnpm --filter @tfx/shared-logic test",
    "test:shared-logic:integration": "pnpm --filter @tfx/shared-logic test:integration",
    "test:contractor-app": "pnpm --filter @tfx/contractor-app test",
    "test:contractor-mobile-app": "pnpm --filter @tfx/contractor-mobile-app test",
    "demo:shared-logic": "node examples/shared_logic_demo.js",
    "demo:contractor-app": "node packages/contractor-app/src/index.js",
    "security:audit": "pnpm audit",
    "security:secrets": "detect-secrets scan --baseline .secrets.baseline --all-files",
    "security:lint": "pre-commit run eslint --all-files",
    "security:all": "pre-commit run --all-files && pnpm audit && npm run security:secrets",
    "security:install-hooks": "pip install pre-commit && pre-commit install && pre-commit install --hook-type commit-msg",
    "security:scan": "node scripts/scan_secrets.cjs",
    "codemod:rename-entities": "jscodeshift -t scripts/codemods/rename-entities.js src/ apps/ packages/ --extensions=js,ts,tsx,jsx",
    "codemod:rename-entities:check": "jscodeshift -t scripts/codemods/rename-entities.js src/ apps/ packages/ --extensions=js,ts,tsx,jsx --dry --print --silent | grep -q 'Contractor|Association' && (echo 'Legacy tokens found!' && exit 1) || echo 'No legacy tokens.'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@prisma/internals": "^7.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.6",
    "@semantic-release/npm": "^11.0.0",
    "@semantic-release/release-notes-generator": "^12.0.0",
    "@tfx/contractor-app": "workspace:*",
    "@tfx/shared-logging": "workspace:*",
    "@tfx/shared-logic": "workspace:*",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "conventional-changelog-cli": "^4.1.0",
    "express": "^5.2.1",
    "jest": "^30.3.0",
    "jscodeshift": "^17.3.0",
    "prisma": "^7.6.0",
    "semantic-release": "^22.0.0",
    "ts-jest": "^29.4.9",
    "ts-morph": "^27.0.2",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "applicationinsights": "^3.14.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.15.0",
    "body-parser": "^2.2.2",
    "express-rate-limit": "^8.3.2",
    "ioredis": "^5.10.1",
    "prom-client": "^15.1.3",
    "supertest": "^7.2.2",
    "winston": "^3.19.0"
  }
}