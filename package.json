{
  "name": "tfxhub-ml-automation",
  "displayName": "TFXHub ML Automation",
  "description": "VS Code extension for OpenAI integration with AWS Secrets Manager, ML automation, and workflow adaptation.",
  "version": "0.0.1",
  "engines": {
    "vscode": ">=1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:tfxhub-ml-automation.runCompletion"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tfxhub-ml-automation.runCompletion",
        "title": "TFXHub: Run OpenAI Completion"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "typescript": "^4.7.0",
    "vscode-test": "^1.6.0"
  },
  "dependencies": {
    "aws-sdk": "^2.0.0",
    "mocha": "^11.7.5",
    "openai": "^4.21.0"
  },
  "type": "module"
}
