# Demo Dockerfile for TFX Hub
FROM node:20-alpine
WORKDIR /app
# Copy minimal backend package.json and tsconfig
COPY demo-backend/package.json ./
COPY demo-backend/tsconfig.json ./
# Install only minimal dependencies
RUN npm install --omit=dev
# Copy backend source files
COPY src ./src
# Build TypeScript
RUN npx tsc --project tsconfig.json
# Set environment and run
ENV NODE_ENV=production
CMD ["node", "dist/server.js"]
