{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "types": ["jest"],
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "allowJs": false,
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["apps/**/*", "packages/**/*", "tests/**/*"]
}
