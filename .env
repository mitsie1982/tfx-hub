# Copy to .env and fill values. DO NOT commit .env to source control.

# Embedding API
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
EMBEDDING_MODEL=text-embedding-3-small

# Index output
FAISS_INDEX_PATH=out/faiss.index
META_PATH=out/meta.json

# RAG tuning
RAG_CHUNK_SIZE=1500
RAG_MAX_TOKENS=2000

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=

# Local secrets folder (optional)
TFXHUB_SECRETS_DIR=${HOME}/.tfxhub-secrets
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
