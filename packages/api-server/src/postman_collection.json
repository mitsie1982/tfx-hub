{
  "info": {
    "name": "TFX Hub Public API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get User Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{api_key}}", "type": "text" }
        ],
        "url": {
          "raw": "https://yourdomain/api/public/user/{{userId}}",
          "host": ["https://yourdomain"],
          "path": ["api", "public", "user", "{{userId}}"]
        }
      }
    },
    {
      "name": "Get Reputation Score",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{api_key}}", "type": "text" }
        ],
        "url": {
          "raw": "https://yourdomain/api/public/reputation/{{userId}}",
          "host": ["https://yourdomain"],
          "path": ["api", "public", "reputation", "{{userId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "api_key", "value": "" },
    { "key": "userId", "value": "" }
  ]
}
