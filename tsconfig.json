{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "allowJs": true,
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "types": ["jest"],
    "esModuleInterop": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@tfx/shared-ui": ["packages/shared-ui/src"],
      "@tfx/shared-logic": ["packages/shared-logic/src"]
    }
  },
  "include": ["src/**/*", "prisma/**/*", "tests/**/*"],
  "exclude": ["apps/**/*", "packages/**/*"]
}
