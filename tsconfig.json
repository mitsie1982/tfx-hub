{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@tfx/shared-ui": ["packages/shared-ui/src"],
      "@tfx/shared-logic": ["packages/shared-logic/src"]
    }
  },
  "include": ["apps/**/*", "packages/**/*"]
}
